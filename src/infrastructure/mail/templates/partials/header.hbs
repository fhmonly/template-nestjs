<html lang="en"><head></head><body style="
    margin:0;
    padding:0;
    background-color:#f4f7fb;
    font-family:Arial,Helvetica,sans-serif;
  "><meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}}</title>



  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="
      background-color:#f4f7fb;
      padding:20px 12px;
    ">
    <tbody><tr>
      <td align="center">

        <!-- Main Container -->
        <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="
            max-width:600px;
            background:#ffffff;
            border-radius:16px;
            overflow:hidden;
          ">

          <!-- Header -->
          <tbody><tr>
            <td align="center" style="
                background:#2563eb;
                padding:32px 24px;
              ">
              <h1 style="
                  margin:0;
                  color:#ffffff;
                  font-size:28px;
                  font-weight:700;
                ">
                {{appName}}
              </h1>

              <p style="
                  margin:10px 0 0;
                  color:#dbeafe;
                  font-size:14px;
                ">
                {{title}}
              </p>
            </td>
          </tr>

          <!-- Content -->
          <tr>
            <td style="
                padding:32px 24px;
                color:#374151;
              ">